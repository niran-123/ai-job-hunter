{
  "name": "ai-global-job-hunter-root",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "AI Global Job Hunter - Automated AI-Powered Global Job Discovery and Tracking Platform",
  "workspaces": [
    "server",
    "client",
    "worker",
    "shared"
  ],
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev:worker": "npm --prefix worker run dev",
    "build:client": "npm --prefix client run build",
    "test": "node --test tests/**/*.test.js",
    "test:eligibility": "node --test tests/unit/eligibility.test.js",
    "test:normalization": "node --test tests/unit/normalization.test.js",
    "test:matching": "node --test tests/unit/matching.test.js",
    "test:duplicates": "node --test tests/unit/duplicates.test.js",
    "test:worker": "node --test tests/unit/worker.test.js",
    "test:api": "node --test tests/integration/api.test.js"
  },
  "keywords": [
    "job-hunter",
    "ai",
    "bullmq",
    "react",
    "express",
    "prisma",
    "postgresql"
  ],
  "author": "AI Global Job Hunter Team",
  "license": "MIT"
}
