NODE_ENV=development

PORT=5000
FRONTEND_URL=http://localhost:5173

# Database configuration (PostgreSQL)
DATABASE_URL=postgresql://jobhunter:hunterpass@localhost:5432/jobhunter_db?schema=public

# Redis configuration (for BullMQ queues)
REDIS_URL=redis://localhost:6379

# Authentication & Security
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars
ENCRYPTION_KEY=12345678901234567890123456789012

# AI Providers
OPENAI_API_KEY=
GEMINI_API_KEY=
DEFAULT_AI_PROVIDER=gemini

# Google OAuth & Gmail API (for daily digest)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/notifications/gmail/callback
GMAIL_SENDER_EMAIL=

# Schedules & Policies
DEFAULT_TIMEZONE=Asia/Kolkata
DAILY_DIGEST_TIME=08:00

MAX_JOB_AGE_DAYS=30
MAX_EXPERIENCE_YEARS=2

# Monitoring & Logging
LOG_LEVEL=info
SENTRY_DSN=

